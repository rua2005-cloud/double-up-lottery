rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/scores/{scoreId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['score', 'games', 'totalPaid', 'finishedAt'])
        && request.resource.data.score is int
        && request.resource.data.games is int
        && request.resource.data.totalPaid is int
        && request.resource.data.score >= 0
        && request.resource.data.games >= 0
        && request.resource.data.totalPaid >= 0;
      allow update, delete: if false;
    }
  }
}
